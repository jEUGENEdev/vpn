[Unit]
Description=Renew API certificate without changing its pinned public key
[Service]
Type=oneshot
ExecStart=/usr/local/bin/linevpn-keygen -dir /etc/linevpn -ip {{ vpn_public_ip }} -renew
ExecStartPost=/usr/bin/chown linevpn:linevpn /etc/linevpn/api-cert.pem
ExecStartPost=/usr/bin/systemctl restart linevpn.service
UMask=0077
