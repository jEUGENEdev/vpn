{
  "name": "linevpn-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Линия — VPN с разрешениями для адресов",
  "author": "jEUGENEdev",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.linevpn.desktop",
    "productName": "LineVPN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "agent"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "artifactName": "LineVPN-${version}-macos-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 265,
          "y": 290,
          "type": "file",
          "path": "assets/Install-Service.command"
        },
        {
          "x": 130,
          "y": 290,
          "type": "file",
          "path": "assets/Install-LineVPN-Service.pkg"
        }
      ]
    },
    "win": {
      "target": [
        "msi"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "msi": {
      "perMachine": true,
      "runAfterFinish": false,
      "warningsAsErrors": false
    }
  }
}
