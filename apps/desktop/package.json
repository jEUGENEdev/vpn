{
  "name": "linevpn-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Сеть — VPN с разрешениями для приложений и адресов",
  "author": "jEUGENEdev",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "node package.cjs"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@^9.0.0": "11.0.9",
    "minimatch@^10.0.0": "11.0.9"
  },
  "build": {
    "appId": "dev.linevpn.desktop",
    "productName": "Сеть",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "control.cjs",
      "branding/*.png",
      {
        "from": "../../internal/ui/client",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "agent"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "artifactName": "Сеть-${version}-macos-${arch}.${ext}",
      "notarize": false,
      "icon": "branding/set.icns"
    },
    "win": {
      "target": [
        "msi"
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "branding/set.ico"
    },
    "msi": {
      "perMachine": true,
      "runAfterFinish": false,
      "warningsAsErrors": false
    },
    "afterSign": "notarize.cjs",
    "executableName": "LineVPN"
  }
}
