{
  "name": "linevpn-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Линия — VPN с разрешениями для адресов",
  "author": "jEUGENEdev",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "node package.cjs"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.linevpn.desktop",
    "productName": "LineVPN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "agent"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "artifactName": "LineVPN-${version}-macos-${arch}.${ext}",
      "notarize": false
    },
    "win": {
      "target": [
        "msi"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "msi": {
      "perMachine": true,
      "runAfterFinish": false,
      "warningsAsErrors": false
    },
    "afterSign": "notarize.cjs"
  }
}
