#!/bin/bash
set -euo pipefail
# preinstall stopped the old service before Installer replaced the payload.
[[ "${3:-/}" == / ]] || { echo 'Install LineVPN on the running system volume.' >&2; exit 1; }
# Called by Apple's Installer as root; no credentials are stored here.
if ! /usr/bin/id _linevpn >/dev/null 2>&1; then
  vpn_uid=399
  # The account and group share a number; it must be unused in BOTH namespaces.
  # macOS may reserve a GID even when no user has the corresponding UID.
  vpn_used_ids="$( { /usr/bin/dscl . -list /Users UniqueID; /usr/bin/dscl . -list /Groups PrimaryGroupID; } | /usr/bin/awk '{print $2}')"
  while printf '%s\n' "$vpn_used_ids" | /usr/bin/grep -x "$vpn_uid" >/dev/null; do
    vpn_uid=$((vpn_uid - 1))
    [[ "$vpn_uid" -ge 200 ]] || { echo 'No unused service UID/GID' >&2; exit 1; }
  done
  /usr/bin/dscl . -create /Groups/_linevpn
  /usr/bin/dscl . -create /Groups/_linevpn PrimaryGroupID "$vpn_uid"
  /usr/bin/dscl . -create /Users/_linevpn
  /usr/bin/dscl . -create /Users/_linevpn UniqueID "$vpn_uid"
  /usr/bin/dscl . -create /Users/_linevpn PrimaryGroupID "$vpn_uid"
  /usr/bin/dscl . -create /Users/_linevpn UserShell /usr/bin/false
  /usr/bin/dscl . -create /Users/_linevpn NFSHomeDirectory /var/empty
  /usr/bin/dscl . -create /Users/_linevpn IsHidden 1
fi
mkdir -p /var/lib/linevpn
chmod 711 /var/lib/linevpn
if /bin/launchctl print system/dev.linevpn.agent >/dev/null 2>&1 || /usr/bin/pgrep -x linevpn-agent >/dev/null 2>&1; then
  echo 'A previous LineVPN service is still running; refusing to start a second instance.' >&2
  exit 1
fi
/bin/launchctl enable system/dev.linevpn.agent
/bin/launchctl bootstrap system /Library/LaunchDaemons/dev.linevpn.agent.plist
