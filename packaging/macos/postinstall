#!/bin/bash
set -euo pipefail
# preinstall rejected existing services and payload before this fresh install.
[[ "${3:-/}" == / ]] || { echo 'Install Сеть on the running system volume.' >&2; exit 1; }
# Called by Apple's Installer as root; no credentials are stored here.
[[ "$EUID" -eq 0 && "${3:-/}" == / ]] || { echo 'Install on the running system volume as root.' >&2; exit 1; }
vpn_tools="$(cd "$(dirname "$0")" && pwd)"
source "$vpn_tools/service-account.sh"
vpn_check_service_account
if [[ -z "$vpn_service_id" ]]; then
  vpn_service_id=399
  # The account and group share a number; it must be unused in BOTH namespaces.
  # macOS may reserve a GID even when no user has the corresponding UID.
  vpn_used_ids="$(printf '%s\n' "$vpn_users" "$vpn_groups" "$vpn_primary_groups" | /usr/bin/awk '{print $2}')"
  while printf '%s\n' "$vpn_used_ids" | /usr/bin/grep -x "$vpn_service_id" >/dev/null; do
    vpn_service_id=$((vpn_service_id - 1))
    [[ "$vpn_service_id" -ge 200 ]] || { echo 'No unused service UID/GID' >&2; exit 1; }
  done
fi
if [[ -z "$vpn_group" ]]; then
  /usr/bin/dscl . -create /Groups/_linevpn
  /usr/bin/dscl . -create /Groups/_linevpn PrimaryGroupID "$vpn_service_id"
fi
if [[ -z "$vpn_uid" ]]; then
  /usr/bin/dscl . -create /Users/_linevpn
  /usr/bin/dscl . -create /Users/_linevpn UniqueID "$vpn_service_id"
  /usr/bin/dscl . -create /Users/_linevpn PrimaryGroupID "$vpn_service_id"
  /usr/bin/dscl . -create /Users/_linevpn UserShell /usr/bin/false
  /usr/bin/dscl . -create /Users/_linevpn NFSHomeDirectory /var/empty
  /usr/bin/dscl . -create /Users/_linevpn IsHidden 1
fi
mkdir -p /var/lib/linevpn
chmod 711 /var/lib/linevpn
if /bin/launchctl print system/dev.linevpn.agent >/dev/null 2>&1 || /usr/bin/pgrep -f '^(/bin/(bash|sh) )?/Library/Application Support/LineVPN/(linevpn-agent|service-wrapper\.sh)( |$)' >/dev/null 2>&1; then
  echo 'A previous Сеть service is still running; refusing to start a second instance.' >&2
  exit 1
fi
# Install only our PF hook; preserve every unrelated anchor and live rule.
vpn_pf="$(/usr/bin/mktemp /etc/pf.conf.linevpn.XXXXXX)"
trap '/bin/rm -f "$vpn_pf"' EXIT
/usr/bin/awk '
  /^[[:space:]]*anchor "linevpn"([[:space:]]+out[[:space:]]+quick)?[[:space:]]*$/ {
    if (!found++) print "anchor \"linevpn\""
    next
  }
  { print }
  END { if (!found) print "anchor \"linevpn\"" }
' /etc/pf.conf > "$vpn_pf"
/sbin/pfctl -nf "$vpn_pf"
/bin/cat "$vpn_pf" > /etc/pf.conf
/bin/launchctl enable system/dev.linevpn.agent
/bin/launchctl bootstrap system /Library/LaunchDaemons/dev.linevpn.agent.plist
# A registered launchd job may still fail during startup. Check the authenticated
# API before reporting success; leave saved policy and protection untouched.
'/Library/Application Support/LineVPN/linevpn-agent' -data /var/lib/linevpn -check-service
