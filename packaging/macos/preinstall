#!/bin/bash
# Installation has one entry point: an empty machine after explicit removal.
set -euo pipefail
[[ "$EUID" -eq 0 && "${3:-/}" == / ]] || { echo 'Install on the running system volume as root.' >&2; exit 1; }
for vpn_path in /Applications/Сеть.app /Applications/LineVPN.app \
  '/Library/Application Support/LineVPN' /Library/LaunchDaemons/dev.linevpn.agent.plist /var/lib/linevpn; do
  if [[ -e "$vpn_path" || -L "$vpn_path" ]]; then
    echo 'Сначала откройте этот установщик и выберите «Удалить». Затем запустите установку заново.' >&2
    exit 1
  fi
done
if /usr/sbin/pkgutil --pkg-info dev.linevpn.service >/dev/null 2>&1 ||
   /bin/launchctl print system/dev.linevpn.agent >/dev/null 2>&1 ||
   /usr/bin/pgrep -f '^(/bin/(bash|sh) )?/Library/Application Support/LineVPN/(linevpn-agent|service-wrapper\.sh)( |$)' >/dev/null; then
  echo 'Прежняя установка ещё зарегистрирована. Сначала выберите «Удалить» в этом установщике.' >&2
  exit 1
fi
