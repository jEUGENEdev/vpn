#!/bin/bash
# Stop the old processes BEFORE Installer replaces their executable/scripts.
set -euo pipefail
[[ "$EUID" -eq 0 ]] || { echo 'Installer must run as root.' >&2; exit 1; }
[[ "${3:-/}" == / ]] || { echo 'Install Сеть on the running system volume.' >&2; exit 1; }

for vpn_bundle in /Applications/Сеть.app /Applications/LineVPN.app; do
  if [[ -d "$vpn_bundle" ]] && [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$vpn_bundle/Contents/Info.plist" 2>/dev/null || true)" != dev.linevpn.desktop ]]; then
    echo 'Another application occupies the installation path; it will not be replaced.' >&2
    exit 1
  fi
done

vpn_version="$(cat "$(dirname "$0")/version")"
vpn_installed="$(/usr/sbin/pkgutil --pkg-info dev.linevpn.service 2>/dev/null | /usr/bin/awk '/^version:/ {print $2}' || true)"
installed_app_version() {
  local vpn_bundle="$1" vpn_value
  # PlistBuddy prints "File Doesn't Exist, Will Create" to stdout for an
  # absent plist. Neither a fresh install nor the unused app name has a version.
  [[ -d "$vpn_bundle" ]] || return 0
  if [[ ! -f "$vpn_bundle/Contents/Info.plist" ]] ||
     ! vpn_value="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$vpn_bundle/Contents/Info.plist" 2>/dev/null)" ||
     [[ -z "$vpn_value" ]]; then
    printf 'Cannot read installed Сеть version: %s/Contents/Info.plist\n' "$vpn_bundle" >&2
    return 1
  fi
  printf '%s\n' "$vpn_value"
}
vpn_app_version="$(installed_app_version /Applications/LineVPN.app)"
vpn_set_version="$(installed_app_version /Applications/Сеть.app)"
for vpn_previous in "$vpn_installed" "$vpn_app_version" "$vpn_set_version"; do
if [[ -n "$vpn_previous" ]]; then
  # All shipped receipts use three numeric components. Unknown receipts must
  # be inspected, never silently downgraded or removed.
  for value in "$vpn_version" "$vpn_previous"; do
    [[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Cannot compare installed Сеть version.' >&2; exit 1; }
  done
  IFS=. read -r vpn_major vpn_minor vpn_patch <<< "$vpn_version"
  IFS=. read -r vpn_old_major vpn_old_minor vpn_old_patch <<< "$vpn_previous"
  if (( 10#$vpn_old_major > 10#$vpn_major ||
        (10#$vpn_old_major == 10#$vpn_major && 10#$vpn_old_minor > 10#$vpn_minor) ||
        (10#$vpn_old_major == 10#$vpn_major && 10#$vpn_old_minor == 10#$vpn_minor && 10#$vpn_old_patch > 10#$vpn_patch) )); then
    echo 'A newer Сеть version is installed. Keeping it and its data.' >&2
    exit 1
  fi
fi
done

# Use the NEW helper in the package, even when the installed scripts are broken.
/bin/bash "$(dirname "$0")/stop-service.sh"
