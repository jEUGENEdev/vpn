#!/bin/bash
set -euo pipefail
# Installer invokes this BEFORE replacing the agent and its running supervisor.
[[ "$EUID" -eq 0 ]] || { echo 'Installer must run as root.' >&2; exit 1; }
[[ "${3:-/}" == / ]] || { echo 'Install LineVPN on the running system volume.' >&2; exit 1; }
if /bin/launchctl print system/dev.linevpn.agent >/dev/null 2>&1; then
  /bin/launchctl bootout system/dev.linevpn.agent 2>/dev/null || true
fi
# bootout can return before launchd has finished reaping the job and its worker.
# Do not overwrite any executable if the old service cannot be stopped.
for ((vpn_attempt=0; vpn_attempt<30; vpn_attempt++)); do
  if ! /bin/launchctl print system/dev.linevpn.agent >/dev/null 2>&1 &&
     ! /usr/bin/pgrep -x linevpn-agent >/dev/null 2>&1; then
    exit 0
  fi
  /bin/sleep 1
done
echo 'Cannot stop the previous LineVPN service; existing files and profile were kept. Retry after stopping the service.' >&2
exit 1
